generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Staff roles — project-description.md → User Roles & Permissions.
// Member (portal) accounts are a separate model (see Member below), not a StaffRole.
enum StaffRole {
  SuperAdmin
  Manager
  Treasurer
  Secretary
  LoanOfficer
  Cashier
  AccountsOfficer
  RecoveryOfficer
  Auditor
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  phone         String?
  emailVerified Boolean
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  role          StaffRole  @default(LoanOfficer)
  branchId      String?
  branch        Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sessions      Session[]
  accounts      Account[]

  // KYC identity fields captured at staff registration — required for every
  // NEW hire (enforced in lib/schemas/staff.ts) so a staff member with
  // access to cash/loan approvals can always be identified and located.
  // Nullable at the DB level only because staff registered before this was
  // added predate it; nothing here is optional going forward.
  nationalIdNumber String?
  idDocumentUrl    String? // scan/photo of their national ID
  selfieUrl        String? // photo captured at registration, for identification
  district         String?
  subCounty        String?
  village          String?
  nextOfKinName    String?
  nextOfKinPhone   String?

  preparedApplications LoanApplication[] @relation("PreparedApplications")
  disbursementInitiatedApplications LoanApplication[] @relation("DisbursementInitiator")
  approvalSteps        ApprovalStep[]
  disbursedLoans       Loan[]            @relation("DisbursedLoans")
  collectedRepayments  Repayment[]
  recoveryCases        RecoveryCase[]
  auditLogs            AuditLog[]
  savingsTransactions  SavingsTransaction[]
  confirmedSavingsTransactions SavingsTransaction[] @relation("ConfirmedSavingsTransactions")
  approvedSavingsTransactions  SavingsTransaction[] @relation("ApprovedSavingsTransactions")
  loanNotes            LoanNote[]            @relation("LoanNoteAuthor")
  resolvedLoanNotes    LoanNote[]            @relation("LoanNoteResolved")
  loanAdjustments      LoanAdjustment[]
  requestedLoanProductChanges LoanProductChangeRequest[] @relation("LoanProductChangeRequested")
  reviewedLoanProductChanges  LoanProductChangeRequest[] @relation("LoanProductChangeReviewed")

  @@index([branchId])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ── Member portal auth — a separate Better Auth instance (lib/member-auth.ts)
// so staff and member sessions never share a cookie or table.
model MemberUser {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  emailVerified Boolean
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  memberId      String?         @unique
  member        Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  sessions      MemberSession[]
  accounts      MemberAccount[]
  initiatedSavingsTransactions SavingsTransaction[]
  initiatedLoanRepayments      Repayment[]
  submittedLoanApplications    LoanApplication[]

  @@map("member_user")
}

model MemberSession {
  id        String     @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      MemberUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("member_session")
}

model MemberAccount {
  id                    String     @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  user                  MemberUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member_account")
}

model MemberVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("member_verification")
}

// ── Phase 2 — Branches, Members, Loan Products ──────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  district  String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff   User[]
  members Member[]
  loans      Loan[]
  repayments Repayment[]
  savingsTransactions SavingsTransaction[]
  ledgerEntries       LedgerEntry[]

  @@map("branch")
}

enum Gender {
  Male
  Female
}

enum MemberStatus {
  Active
  Inactive
  Suspended
}

model Member {
  id               String       @id @default(cuid())
  sequenceNumber   Int          @default(autoincrement())
  memberNumber     String       @unique
  firstName        String
  lastName         String
  phone            String
  email            String?
  nin              String?      @unique
  nationalIdNumber String?
  dob              DateTime?
  gender           Gender?
  occupation       String?
  employer         String?
  district         String?
  subCounty        String?
  village          String?
  dateJoined       DateTime     @default(now())
  status           MemberStatus @default(Active)
  photoUrl         String?
  signatureUrl     String?
  nextOfKinName    String?
  nextOfKinPhone   String?
  emergencyContact String?
  // Withdrawal policy — "Freeze withdrawals for accounts under
  // investigation": blocks every self-service withdrawal across all of this
  // member's savings accounts (deposits/loans stay unaffected — this is
  // scoped narrowly to what was asked for, not a general account lock).
  withdrawalsFrozen Boolean   @default(false)
  frozenReason      String?
  frozenAt          DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  documents        MemberDocument[]
  guarantors       Guarantor[]
  memberUser       MemberUser?
  loanApplications LoanApplication[]
  loans            Loan[]
  savingsAccounts  SavingsAccount[]

  @@index([branchId])
  @@index([status])
  @@map("member")
}

enum MemberDocumentType {
  NationalId
  Passport
  UtilityBill
  EmploymentLetter
  MembershipAgreement
}

model MemberDocument {
  id         String             @id @default(cuid())
  memberId   String
  member     Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type       MemberDocumentType
  fileUrl    String
  uploadedAt DateTime           @default(now())

  @@index([memberId])
  @@map("member_document")
}

enum InterestMethod {
  Flat
  ReducingBalance
  Declining
  Compound
  Custom
}

model LoanProduct {
  id                    String         @id @default(cuid())
  name                  String
  interestRate          Float
  minAmount             Int
  maxAmount             Int
  repaymentPeriodMonths Int
  gracePeriodDays       Int            @default(0)
  penaltyRate           Float          @default(0)
  processingFee         Float          @default(0)
  insuranceFee          Float          @default(0)
  lateFee               Float          @default(0)
  serviceCharge         Float          @default(0)
  interestMethod        InterestMethod @default(ReducingBalance)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  loanApplications LoanApplication[]
  changeRequests   LoanProductChangeRequest[]

  @@map("loan_product")
}

enum LoanProductChangeRequestStatus {
  Pending
  Approved
  Rejected
}

/**
 * Maker-checker for loan products, mirroring the loan-application workflow
 * in lib/loan-workflow.ts: a SuperAdmin/Manager proposes a create or update
 * as a pending JSON diff rather than writing straight to LoanProduct, and a
 * DIFFERENT SuperAdmin/Manager must approve it before the change actually
 * applies. Closes a real gap — loan product create/edit previously wrote no
 * audit trail at all and had no approval gate, unlike every other
 * money-adjacent workflow in this app. `targetProductId` is null for a
 * proposed new product; `changes` holds the full proposed LoanProduct field
 * set (matches lib/schemas/loan-product.ts's shape) either way.
 */
model LoanProductChangeRequest {
  id                String                          @id @default(cuid())
  targetProductId   String?
  targetProduct     LoanProduct?                     @relation(fields: [targetProductId], references: [id])
  changes           Json
  requestedByUserId String
  requestedBy       User                             @relation("LoanProductChangeRequested", fields: [requestedByUserId], references: [id])
  status            LoanProductChangeRequestStatus   @default(Pending)
  reviewedByUserId  String?
  reviewedBy        User?                            @relation("LoanProductChangeReviewed", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  comments          String?
  createdAt         DateTime                         @default(now())

  @@index([targetProductId])
  @@index([status])
  @@map("loan_product_change_request")
}

enum GuarantorStatus {
  Active
  Blocked
}

model Guarantor {
  id                String           @id @default(cuid())
  memberId          String
  member            Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  loanApplicationId String?
  loanApplication   LoanApplication? @relation(fields: [loanApplicationId], references: [id], onDelete: SetNull)
  loanId            String?
  loan              Loan?            @relation(fields: [loanId], references: [id], onDelete: SetNull)
  guaranteeAmount   Int
  status            GuarantorStatus  @default(Active)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([memberId])
  @@index([loanApplicationId])
  @@index([loanId])
  @@map("guarantor")
}

// Declared at application time (loanApplicationId); loanId is populated once
// the application is disbursed and a Loan record exists.
model Collateral {
  id                String           @id @default(cuid())
  loanApplicationId String?
  loanApplication   LoanApplication? @relation(fields: [loanApplicationId], references: [id], onDelete: SetNull)
  loanId            String?
  loan              Loan?            @relation(fields: [loanId], references: [id], onDelete: SetNull)
  description       String
  estimatedValue    Int
  documentUrl       String?
  createdAt         DateTime         @default(now())

  @@index([loanApplicationId])
  @@index([loanId])
  @@map("collateral")
}

// ── Phase 3 — Loan Lifecycle & Approval Workflow ────────────────────────────

enum ApplicationStatus {
  PendingLoanOfficer
  PendingSecretary
  PendingTreasurer
  PendingManager
  PendingDisbursement
  Disbursed
  Rejected
  Returned
}

enum LoanApplicationChannel {
  Staff
  MemberPortal
}

enum IdentificationType {
  NationalId
  Passport
  VotersId
  DriversLicense
}

enum NinVerificationStatus {
  NotChecked
  Matched
  Mismatch
  Unavailable
}

model LoanApplication {
  id                     String            @id @default(cuid())
  memberId               String
  member                 Member            @relation(fields: [memberId], references: [id])
  loanProductId          String
  loanProduct            LoanProduct       @relation(fields: [loanProductId], references: [id])
  amount                 Int
  purpose                String
  repaymentPeriodMonths  Int
  interestMethod         InterestMethod
  riskScore              Int               @default(0)
  riskFlags              String[]          @default([])
  status                 ApplicationStatus @default(PendingSecretary)
  // Staff-prepared applications start at PendingSecretary and go through the
  // full Secretary→Treasurer→Manager chain; member self-service submissions
  // start at PendingLoanOfficer instead and skip straight to Manager after
  // that (see lib/loan-workflow.ts) — a member has no Secretary to prepare
  // on their behalf, but a Loan Officer must still vet the application.
  channel                 LoanApplicationChannel @default(Staff)
  preparedByUserId       String?
  preparedBy             User?             @relation("PreparedApplications", fields: [preparedByUserId], references: [id])
  submittedByMemberUserId String?
  submittedByMemberUser   MemberUser?      @relation(fields: [submittedByMemberUserId], references: [id])
  // Who clicked "Disburse" for a Mobile Money payout — the DGateway webhook
  // that later confirms the payout runs with no staff session available, so
  // this is what it uses for Loan.disbursedByUserId (previously reused
  // preparedByUserId as a proxy, which broke once that became nullable).
  disbursementInitiatedByUserId String?
  disbursementInitiatedBy       User?      @relation("DisbursementInitiator", fields: [disbursementInitiatedByUserId], references: [id])
  supportingDocumentUrls String[]          @default([])
  // Set while a Mobile Money disbursement payout is in flight. The Loan row
  // is only created once DGateway's webhook confirms — status stays
  // PendingDisbursement until then, so a gateway failure never leaves a
  // half-disbursed loan on the books.
  disbursementTransactionRef String?
  // The Mobile Money number a MobileMoney disbursement was sent to — recorded
  // at initiation time so it survives independently of the audit log.
  disbursementPhone          String?
  disbursementNetwork        MobileMoneyNetwork?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  // Applicant profile captured at application time (KYC + capacity
  // assessment) — kept optional at the DB level even though the create
  // form requires ID fields going forward, so existing rows aren't broken.
  idType             IdentificationType?
  idNumber           String?
  idIssueDate        DateTime?
  idExpiryDate       DateTime?
  applicantPhotoUrl  String?
  dependents         Int?

  // Government ID verification (NIRA NIN check for National ID applicants).
  ninVerificationStatus NinVerificationStatus @default(NotChecked)
  ninVerificationDetail String?
  ninVerifiedAt         DateTime?
  businessName       String?
  businessAddress    String?
  businessLocation   String?
  businessPhone      String?
  yearsInBusiness    Int?
  businessCapital    Int?
  businessMonthlyIncome Int?
  employerName       String?
  position           String?
  yearsWithEmployer  Int?
  employerPhone      String?
  netMonthlyIncome   Int?

  // Loan officer's document-verification + electronic sign-off, captured
  // at application time — an attestation that supporting income evidence
  // was physically/digitally reviewed before the application moves on.
  officerVerifiedBusinessLetter Boolean  @default(false)
  officerVerifiedPayslip        Boolean  @default(false)
  officerSignatureData          String?
  officerSignedAt               DateTime?

  guarantors    Guarantor[]
  collateral    Collateral[]
  approvalSteps ApprovalStep[]
  loan          Loan?

  @@index([memberId])
  @@index([status])
  @@map("loan_application")
}

enum ApprovalStage {
  LoanOfficer
  Secretary
  Treasurer
  Manager
  Disbursement
}

enum ApprovalAction {
  Approve
  Reject
  Return
}

model ApprovalStep {
  id                String          @id @default(cuid())
  loanApplicationId String
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  stage             ApprovalStage
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  action            ApprovalAction
  comments          String?
  ipAddress         String?
  createdAt         DateTime        @default(now())

  @@index([loanApplicationId])
  @@map("approval_step")
}

enum LoanStatus {
  Active
  PaidOff
  Overdue
  Defaulted
  WrittenOff
}

enum DisbursementMethod {
  Cash
  Bank
  MobileMoney
}

model Loan {
  id                    String             @id @default(cuid())
  loanApplicationId     String             @unique
  loanApplication       LoanApplication    @relation(fields: [loanApplicationId], references: [id])
  memberId              String
  member                Member             @relation(fields: [memberId], references: [id])
  branchId              String
  branch                Branch             @relation(fields: [branchId], references: [id])
  principal             Int
  interestRate           Float
  interestMethod        InterestMethod
  repaymentPeriodMonths Int
  disbursedAt           DateTime           @default(now())
  disbursedByUserId     String
  disbursedBy           User               @relation("DisbursedLoans", fields: [disbursedByUserId], references: [id])
  disbursementMethod    DisbursementMethod
  status                LoanStatus         @default(Active)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  repayments    Repayment[]
  guarantors    Guarantor[]
  collateral    Collateral[]
  recoveryCase  RecoveryCase?
  notes         LoanNote[]
  adjustments   LoanAdjustment[]

  @@index([memberId])
  @@index([branchId])
  @@index([status])
  @@map("loan")
}

enum LoanAdjustmentType {
  WriteOff
  Reschedule
  InterestWaiver
}

/**
 * An audited restructuring event on an already-disbursed loan — write-off,
 * rescheduling, or an interest waiver — kept as its own append-only record
 * rather than silently mutating Loan fields, so "why is this loan's balance/
 * term different from what it was disbursed as" always has an answer.
 * amount is the written-off/waived amount; the repaymentPeriodMonths pair is
 * only set for a Reschedule (the amortization schedule itself is never
 * stored — app/api/loans/[id]/route.ts regenerates it fresh from
 * Loan.repaymentPeriodMonths on every read, so updating that one field is
 * sufficient to reschedule).
 */
model LoanAdjustment {
  id                            String             @id @default(cuid())
  loanId                        String
  loan                          Loan               @relation(fields: [loanId], references: [id])
  type                          LoanAdjustmentType
  amount                        Int?
  previousRepaymentPeriodMonths Int?
  newRepaymentPeriodMonths      Int?
  reason                        String
  requestedByUserId             String
  requestedBy                   User               @relation(fields: [requestedByUserId], references: [id])
  createdAt                     DateTime           @default(now())

  @@index([loanId])
  @@map("loan_adjustment")
}

enum DisputeStatus {
  Open
  Investigating
  Resolved
}

model LoanNote {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("LoanNoteAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  // A note flagged as a dispute (e.g. "member says he didn't receive the
  // disbursement") previously had no way to be distinguished from routine
  // commentary, tracked to resolution, or surfaced at a glance on the loan
  // — it lived only in whichever staff member happened to notice it.
  isDispute        Boolean        @default(false)
  disputeStatus    DisputeStatus?
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedBy       User?          @relation("LoanNoteResolved", fields: [resolvedByUserId], references: [id])

  @@index([loanId])
  @@index([isDispute])
  @@map("loan_note")
}

enum RepaymentMethod {
  Cash
  Bank
  MobileMoney
  Cheque
  Online
}

enum RepaymentStatus {
  Pending
  Confirmed
  Failed
}

enum RepaymentChannel {
  Staff
  MemberPortal
}

model Repayment {
  id               String          @id @default(cuid())
  loanId           String
  loan             Loan            @relation(fields: [loanId], references: [id])
  amountPaid       Int
  principalPortion Int
  interestPortion  Int
  penaltyPortion   Int
  // Staff-collected Mobile Money repayments charge the member amountPaid +
  // this fee on top (see lib/repayment-fee-policy.ts) — the fee is never
  // applied toward the loan, it's retained as SACCO fee income. Zero for
  // every other method and for member self-service Mobile Money repayment
  // (that flow was not asked to carry this fee).
  collectionFeeAmount Int           @default(0)
  method           RepaymentMethod
  // Cash/Bank/Cheque/Online confirm immediately; MobileMoney starts Pending
  // and only the DGateway webhook flips it to Confirmed — the loan balance
  // must not move until that confirmation lands.
  status           RepaymentStatus @default(Confirmed)
  receiptNumber    String          @unique
  transactionId    String?
  // The Mobile Money number this repayment was actually collected from —
  // set only for method=MobileMoney.
  phone            String?
  network          MobileMoneyNetwork?
  // A repayment is either teller-recorded (collectorId set) or member
  // self-service (memberUserId set, channel=MemberPortal) — mirrors
  // SavingsTransaction's channel/memberUserId pattern exactly.
  channel          RepaymentChannel @default(Staff)
  collectorId      String?
  collector        User?           @relation(fields: [collectorId], references: [id])
  memberUserId     String?
  memberUser       MemberUser?     @relation(fields: [memberUserId], references: [id])
  branchId         String
  branch           Branch          @relation(fields: [branchId], references: [id])
  paidAt           DateTime        @default(now())

  @@index([loanId])
  @@map("repayment")
}

enum RecoveryStatus {
  Active
  Promised
  Legal
  Blacklisted
  Recovered
}

model RecoveryCase {
  id                String         @id @default(cuid())
  loanId            String         @unique
  loan              Loan           @relation(fields: [loanId], references: [id])
  recoveryOfficerId String?
  recoveryOfficer   User?          @relation(fields: [recoveryOfficerId], references: [id])
  status            RecoveryStatus @default(Active)
  notes             String?
  visitDate         DateTime?
  recoveredAmount   Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("recovery_case")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  browser    String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// ── Phase 4 — Savings, Accounting & Recovery ────────────────────────────────

enum SavingsAccountType {
  Daily
  Fixed
  Shares
}

model SavingsAccount {
  id             String             @id @default(cuid())
  // DB-level autoincrement — accountNumber is derived from this once the
  // row exists (see app/api/savings-accounts/route.ts), same two-step
  // create-then-update pattern Member.sequenceNumber already uses for
  // memberNumber. Deliberately NOT count(*)-based: that breaks the moment
  // any account is ever deleted, since a lower count regenerates a number
  // that still exists, colliding with accountNumber's unique constraint.
  sequenceNumber Int                @default(autoincrement())
  accountNumber  String             @unique
  memberId      String
  member        Member             @relation(fields: [memberId], references: [id])
  type          SavingsAccountType
  balance       Int                @default(0)
  openedAt      DateTime           @default(now())
  // Only meaningful for type=Fixed — funds are locked until this date (see
  // lib/withdrawal-eligibility.ts). Null on a Fixed account is treated as
  // "no lock enforced" rather than "always locked", since existing Fixed
  // accounts predate this field and have no maturity date on record.
  maturityDate  DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  transactions SavingsTransaction[]

  @@index([memberId])
  @@map("savings_account")
}

enum SavingsTransactionType {
  Deposit
  Withdrawal
  Interest
  // A system-charged deduction (currently: the monthly account maintenance
  // fee, see lib/account-maintenance-fee.ts) — kept distinct from Withdrawal
  // so reports/statements can tell "the member took money out" apart from
  // "the SACCO charged a fee" at a glance.
  Fee
}

enum SavingsTransactionChannel {
  Staff
  MemberPortal
  // Posted by a cron job, not a person — currently only the monthly
  // account maintenance fee.
  System
}

// Staff-recorded transactions settle immediately (Confirmed) — a teller has
// already physically taken the cash/verified the transfer. Member
// self-service ones default to Pending: Mobile Money waits for the DGateway
// webhook (app/api/dgateway/webhook), Bank Transfer waits for a staff member
// to check the bank statement and confirm it (app/api/savings-transactions/[id]/confirm).
// Cash is never a member-portal method — you can't self-service a cash deposit.
enum SavingsTransactionStatus {
  PendingApproval
  Pending
  Confirmed
  Failed
}

enum SavingsTransactionMethod {
  Cash
  MobileMoney
  BankTransfer
  // Automatic bank rail via RohoPay (payment_method=bank_transfer on the
  // same /collect call Mobile Money uses) — confirmed by webhook exactly
  // like Mobile Money, never optimistically. Distinct from BankTransfer
  // (the member-declared-reference-then-staff-confirms flow), which stays
  // untouched as a fallback.
  InstantBankTransfer
  // Not a real payment channel — used for cron-posted entries (the monthly
  // account maintenance fee) where no money actually moves through a rail.
  System
}

// Uganda's Mobile Money prefixes aren't a reliable way to infer the network
// (number portability means a 077x/078x number can have been ported off MTN
// onto Airtel or vice versa) — so the network is captured explicitly at the
// point someone enters a Mobile Money number, rather than guessed from it.
enum MobileMoneyNetwork {
  MTN
  Airtel
}

model SavingsTransaction {
  id               String                 @id @default(cuid())
  savingsAccountId String
  savingsAccount   SavingsAccount         @relation(fields: [savingsAccountId], references: [id])
  type             SavingsTransactionType
  amount           Int
  // Fixed-savings early-withdrawal penalty, if any (see
  // lib/withdrawal-eligibility.ts) — the member's balance is still reduced
  // by the full `amount`, but only `amount - penaltyAmount` is actually
  // paid out; the penalty is retained by the SACCO as fee income.
  penaltyAmount    Int                    @default(0)
  // The balance this transaction WILL produce once Confirmed — for a Pending
  // row this is a projection, not yet applied to SavingsAccount.balance.
  balanceAfter     Int
  branchId         String
  branch           Branch                 @relation(fields: [branchId], references: [id])
  status           SavingsTransactionStatus @default(Confirmed)
  method           SavingsTransactionMethod @default(Cash)
  // DGateway transaction reference (Mobile Money) or the bank's own
  // reference number the member typed in (Bank Transfer).
  transactionId    String?
  // The Mobile Money number this deposit/withdrawal actually moved through —
  // set only for method=MobileMoney. Not always the member's own registered
  // phone (a deposit can be made from any MTN/Airtel line), so this is kept
  // as its own column rather than assumed to equal Member.phone.
  phone            String?
  network          MobileMoneyNetwork?
  // A deposit is either teller-recorded (staffId set) or member self-service
  // (memberUserId set, channel=MemberPortal) — never both. staffId is
  // nullable specifically to allow the latter; the channel field is the
  // authoritative way to tell them apart for audit/reporting.
  channel          SavingsTransactionChannel @default(Staff)
  staffId          String?
  staff            User?                  @relation(fields: [staffId], references: [id])
  memberUserId     String?
  memberUser       MemberUser?            @relation(fields: [memberUserId], references: [id])
  // Which staff member manually confirmed a Pending Bank Transfer deposit
  // (Mobile Money is confirmed by the webhook instead, with no staff actor).
  confirmedByUserId String?
  confirmedBy       User?                 @relation("ConfirmedSavingsTransactions", fields: [confirmedByUserId], references: [id])
  // A self-service Withdrawal above the large-withdrawal threshold sits at
  // status=PendingApproval (no payout has been sent to RohoPay yet) until a
  // staff member approves it — only then does it move to Pending and the
  // real payout goes out. Below the threshold, withdrawals skip straight to
  // Pending like a normal collection/payout.
  approvedByUserId String?
  approvedBy       User?                  @relation("ApprovedSavingsTransactions", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime               @default(now())

  @@index([savingsAccountId])
  @@map("savings_transaction")
}

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

// A small seeded reference list, not a user-editable model — see
// prisma/seed.ts. LedgerEntry.accountCode is a real FK against this so a
// ledger line can never point at a nonexistent account.
model ChartOfAccount {
  code      String      @id
  name      String
  type      AccountType
  createdAt DateTime    @default(now())

  ledgerEntries LedgerEntry[]

  @@map("chart_of_account")
}

model LedgerEntry {
  id            String         @id @default(cuid())
  accountCode   String
  account       ChartOfAccount @relation(fields: [accountCode], references: [code])
  description   String
  debit         Int            @default(0)
  credit        Int            @default(0)
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  // Traces this entry back to the business event that generated it
  // (SavingsTransaction, Repayment, Loan, ...) — without this a ledger line
  // can't be audited back to its source.
  referenceType String?
  referenceId   String?
  createdAt     DateTime       @default(now())

  @@index([accountCode])
  @@index([branchId])
  @@index([referenceType, referenceId])
  @@map("ledger_entry")
}

// Singleton row (id is always the fixed string below) — SuperAdmin-editable
// withdrawal policy, see lib/withdrawal-policy.ts. Kept as one row rather
// than scattered env vars/constants specifically because "Admin Controls"
// (set daily limits, set the large-withdrawal approval threshold) is part
// of the spec this implements — these need to be changeable without a code
// deploy.
model SystemSettings {
  id String @id @default("singleton")

  // Flexible (Daily) savings — minimum balance that must remain after a withdrawal.
  minFlexibleSavingsBalance Int @default(30000)

  // Fixed savings — early withdrawal (before maturityDate) handling.
  fixedEarlyWithdrawalAllowed        Boolean @default(true)
  fixedEarlyWithdrawalPenaltyPercent Float   @default(3)

  // Per-member daily withdrawal caps, across all their savings accounts.
  dailyWithdrawalAmountLimit Int @default(2000000)
  maxWithdrawalsPerDay       Int @default(2)

  // Withdrawals above this amount require staff approval before the real
  // payout is sent; at or below it, they're processed automatically.
  largeWithdrawalApprovalThreshold Int @default(5000000)

  // Loan eligibility policy, see lib/eligibility-policy.ts. Previously
  // hardcoded constants in lib/eligibility-constants.ts — moved here so a
  // SuperAdmin can tune them without a code deploy. Stored as whole-number
  // percentages (10 = 10%) for a friendlier admin form; ratio-form (0.1) is
  // computed on read.
  savingsToLoanRatioPercent   Float @default(10)
  maxDebtToIncomeRatioPercent Float @default(30)
  guarantorExposureLimitUgx   Int   @default(10000000)
  // A flat floor, separate from the ratio above — a member below this
  // savings balance fails eligibility outright, regardless of how small a
  // loan they're requesting (the ratio check alone only warns, never blocks,
  // for a low-but-nonzero balance against a small loan amount).
  minimumSavingsForLoanUgx    Int   @default(30000)

  // Staff-collected Mobile Money loan repayments charge the member this
  // much extra on top of what they owe (see lib/repayment-fee-policy.ts) —
  // the RohoPay prompt shows amountOwed + fee, the fee is retained as
  // SACCO fee income and never applied toward the loan balance.
  mobileMoneyRepaymentFeePercent Float @default(20)

  // The SACCO's own bank account, shown to a member on the deposit page once
  // they pick Bank Transfer so they know where to actually send the money —
  // previously nowhere in the app, even though that deposit channel already
  // existed. Deliberately just display data: the deposit itself still stays
  // a member-declared reference confirmed by staff against the real bank
  // statement (see app/api/savings-transactions/[id]/confirm/route.ts) —
  // no bank API integration exists to verify or move funds automatically.
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankBranch        String?

  // Monthly account maintenance fee (see lib/account-maintenance-fee.ts) —
  // off by default so it never starts silently deducting real members'
  // money the moment this column exists; a SuperAdmin must explicitly turn
  // it on from Settings.
  accountMaintenanceFeeEnabled   Boolean @default(false)
  accountMaintenanceFeeAmountUgx Int     @default(1000)

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
