# ─────────────────────────────────────────────────────────────
# Nexcgen — Environment Variables
# Copy this file to .env.local and fill in real values for local dev.
# .env.local is gitignored; this file (.env.example) is committed.
# ─────────────────────────────────────────────────────────────

# Database — Neon PostgreSQL. Get the pooled connection string from
# your Neon project dashboard → Connection Details.
DATABASE_URL="postgres://user:password@host.neon.tech/dbname?sslmode=verify-full"
# Optional — the DIRECT (non-pooled) connection string, same dashboard page,
# hostname without the "-pooler" segment. Used only by `prisma db push`/
# migrate (see prisma.config.ts) — those are unreliable against Neon's
# pooled/PgBouncer endpoint. The app itself always uses DATABASE_URL above.
DIRECT_URL="postgres://user:password@host.neon.tech/dbname?sslmode=verify-full"

# Cache — Upstash Redis. Get both from the Upstash Console → your
# database → REST API section.
UPSTASH_REDIS_URL="https://<id>.upstash.io"
UPSTASH_REDIS_TOKEN=""

# Auth — Better Auth. Generate BETTER_AUTH_SECRET with `openssl rand -base64 32`
# or randomkeygen.com (32+ chars). BETTER_AUTH_URL is the full app URL.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Email — Resend. API key from the Resend dashboard. RESEND_FROM_EMAIL
# must be a verified sender/domain in Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@nextgensacco.com"

# File storage — Cloudflare R2. From the R2 bucket → Manage API Tokens.
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CLOUDFLARE_R2_BUCKET_NAME="nextgen-sacco-documents"
CLOUDFLARE_R2_PUBLIC_DEV_URL=""

# Mobile Money — RohoPay (MTN/Airtel Mobile Money, UGX). From your RohoPay
# merchant dashboard. Use a test_-prefixed key for local dev; live_-prefixed
# keys move real money. See docs.rohopay.com.
ROHO_API_URL="https://api.rohopay.com"
ROHO_API_KEY=""
# HMAC-SHA256 secret RohoPay signs webhook payloads with (exact header name
# unconfirmed at integration time — see app/api/dgateway/webhook/route.ts).
# Without this set, the webhook endpoint refuses all requests (fails closed).
ROHO_WEBHOOK_SECRET=""

# SMS/WhatsApp — pluggable notification provider (e.g. Africa's Talking).
# Provider implementation lives in lib/notifications.ts.
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SENDER_ID="NGSACCO"

# National ID (NIN) verification — no public NIRA API exists; this uses
# Youverify (youverify.co), a licensed third-party KYC/identity-verification
# vendor, via their Entity Management API. Provider implementation lives in
# lib/nin-verification.ts. Until YOUVERIFY_API_KEY is set, the "Verify with
# NIRA" button in the loan application wizard reports "Unavailable" rather
# than failing. YOUVERIFY_API_URL defaults to production; point it at
# https://api.sandbox.youverify.co to test against a sandbox key.
YOUVERIFY_API_URL=""
YOUVERIFY_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron — protects app/api/cron/* routes from unauthenticated calls. Vercel
# sends this as `Authorization: Bearer <value>` automatically when set as a
# project env var; generate with `openssl rand -base64 32`.
CRON_SECRET=""
